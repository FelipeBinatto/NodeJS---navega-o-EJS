
<%- include("partials/header") %>
<%- include("partials/nav") %>

<main class="container py-5">

  <!-- Apresentação -->
  <section class="mb-5">
    <span class="text-primary fw-semibold small text-uppercase">
      Painel de gerenciamento
    </span>

    <h1 class="fw-bold mt-2 mb-2">
      Bem-vindo ao sistema
    </h1>

    <p class="text-secondary mb-0">
      Gerencie produtos, fornecedores, clientes e categorias
      em um só lugar.
    </p>
  </section>

  <!-- Módulos -->
  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h5 fw-bold mb-0">Módulos do sistema</h2>
      <span class="text-secondary small">4 módulos</span>
    </div>

    <div class="row g-4">

      <!-- Produtos -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 module-card">
          <div class="card-body p-4">
            <div class="module-icon icon-products mb-3">
              <i class="bi bi-box-seam"></i>
            </div>

            <h3 class="h5 fw-bold">Produtos</h3>
            <p class="text-secondary small">
              Consulte e gerencie os produtos cadastrados.
            </p>

            <a href="/produtos"
               class="btn btn-outline-primary w-100 mt-2">
              Ver produtos
              <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Fornecedores -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 module-card">
          <div class="card-body p-4">
            <div class="module-icon icon-suppliers mb-3">
              <i class="bi bi-truck"></i>
            </div>

            <h3 class="h5 fw-bold">Fornecedores</h3>
            <p class="text-secondary small">
              Consulte e organize seus fornecedores cadastrados.
            </p>

            <a href="/fornecedores"
               class="btn btn-outline-primary w-100 mt-2">
              Ver fornecedores
              <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Clientes -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 module-card">
          <div class="card-body p-4">
            <div class="module-icon icon-clients mb-3">
              <i class="bi bi-people"></i>
            </div>

            <h3 class="h5 fw-bold">Clientes</h3>
            <p class="text-secondary small">
              Acesse e gerencie os clientes cadastrados.
            </p>

            <a href="/clientes"
               class="btn btn-outline-primary w-100 mt-2">
              Ver clientes
              <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Categorias -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 module-card">
          <div class="card-body p-4">
            <div class="module-icon icon-categories mb-3">
              <i class="bi bi-tags"></i>
            </div>

            <h3 class="h5 fw-bold">Categorias</h3>
            <p class="text-secondary small">
              Organize os produtos por categoria e veja os cadastrados.
            </p>

            <a href="/categorias"
               class="btn btn-outline-primary w-100 mt-2">
              Ver categorias
              <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Integrantes -->
  <section class="team-section p-4 p-md-5">
    <div class="row align-items-center g-4">
      <div class="col-md-4">
        <span class="text-primary fw-semibold small">
          SOBRE O PROJETO
        </span>
        <h2 class="h4 fw-bold mt-2 mb-2">
          Desenvolvido por
        </h2>
        <p class="text-secondary small mb-0">
          Projeto acadêmico da disciplina de Programação Web II.
        </p>
      </div>

      <div class="col-md-4">
        <div class="team-member">
          <div>
            <h3 class="h6 fw-bold mb-1">
              Felipe Drigo Binatto
            </h3>
            <p class="text-secondary small mb-0">
              2º DS AMS
            </p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="team-member">
          <div>
            <h3 class="h6 fw-bold mb-1">
              Maria Eduarda Silvestre Marcon
            </h3>
            <p class="text-secondary small mb-0">
              2º DS AMS
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include("partials/footer") %>


<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<main class="container py-5">

  <!-- Cabeçalho da página -->
  <div class="page-heading mb-4">
    <a href="/produtos" class="back-link">
      <i class="bi bi-arrow-left me-2"></i>
      Voltar para produtos
    </a>

    <div class="d-flex align-items-center gap-3 mt-3">
      <div class="page-icon">
        <i class="bi bi-pencil-square"></i>
      </div>

      <div>
        <h1 class="h3 fw-bold mb-1">Editar produto</h1>
        <p class="text-secondary mb-0">
          Atualize as informações do produto cadastrado.
        </p>
      </div>
    </div>
  </div>

  <!-- Formulário -->
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">

      <div class="card product-form-card">
        <div class="card-body p-4 p-md-5">

          <form
            action="/produtos/editar/<%= produto.id %>"
            method="POST"
          >

            <div class="form-section-title mb-4">
              <h2 class="h6 fw-bold mb-1">Informações do produto</h2>
              <p class="text-secondary small mb-0">
                Preencha os campos abaixo para atualizar o cadastro.
              </p>
            </div>

            <!-- Nome -->
            <div class="mb-4">
              <label for="nome" class="form-label">
                Nome do produto
              </label>

              <input
                type="text"
                class="form-control"
                id="nome"
                name="nome"
                placeholder="Ex.: Notebook"
                required
                value="<%= produto.nome %>"
              >
            </div>

            <!-- Preço e estoque -->
            <div class="row g-3 mb-4">

              <div class="col-12 col-md-6">
                <label for="preco" class="form-label">
                  Preço (R$)
                </label>

                <div class="input-group">
                  <span class="input-group-text">R$</span>
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-control"
                    id="preco"
                    name="preco"
                    placeholder="0,00"
                    required
                    value="<%= produto.preco %>"
                  >
                </div>
              </div>

              <div class="col-12 col-md-6">
                <label for="estoque" class="form-label">
                  Quantidade em estoque
                </label>

                <input
                  type="number"
                  min="0"
                  step="1"
                  class="form-control"
                  id="estoque"
                  name="estoque"
                  placeholder="Ex.: 10"
                  required
                  value="<%= produto.estoque %>"
                >
              </div>

            </div>

            <!-- Categoria -->
            <div class="mb-4">
              <label for="categoria" class="form-label">
                Categoria
              </label>

              <input
                type="text"
                class="form-control"
                id="categoria"
                name="categoria"
                placeholder="Ex.: Informática"
                required
                value="<%= produto.categoria %>"
              >
            </div>

            <!-- Descrição -->
            <div class="mb-4">
              <label for="descricao" class="form-label">
                Descrição
              </label>

              <textarea
                class="form-control"
                id="descricao"
                name="descricao"
                rows="4"
                placeholder="Descreva o produto"
                required
              ><%= produto.descricao %></textarea>
            </div>

            <hr class="form-divider">

            <!-- Ações -->
            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-2">

              <a href="/produtos" class="btn btn-light btn-form-cancel">
                <i class="bi bi-x-lg me-1"></i>
                Cancelar
              </a>

              <button type="submit" class="btn btn-primary btn-form-save">
                <i class="bi bi-check2 me-1"></i>
                Salvar alterações
              </button>

            </div>

          </form>

        </div>
      </div>

      <p class="text-secondary small mt-3 text-center">
        <i class="bi bi-info-circle me-1"></i>
        Confira os dados antes de salvar as alterações.
      </p>

    </div>
  </div>

</main>

<%- include("../partials/footer") %>
